{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RADIX Sales Intelligence envelope 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "organizationId",
    "clientId",
    "contactId",
    "opportunityId",
    "recordVersion",
    "asOf",
    "stage",
    "amount",
    "amountUnit",
    "currency",
    "probability",
    "closeDate",
    "ownerId",
    "activities",
    "nextAction",
    "dataQuality"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "organizationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "clientId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "contactId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "opportunityId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "recordVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "asOf": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processId",
        "id"
      ],
      "properties": {
        "processId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        }
      }
    },
    "amount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9000000000000
    },
    "amountUnit": {
      "const": "minor"
    },
    "currency": {
      "type": "null"
    },
    "probability": {
      "type": "null"
    },
    "closeDate": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "ownerId": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        {
          "type": "null"
        }
      ]
    },
    "activities": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "id",
              "version",
              "type",
              "title",
              "status",
              "assigneeId",
              "priority",
              "dueAt"
            ],
            "properties": {
              "source": {
                "const": "tasks"
              },
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "type": {
                "const": "task"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "status": {
                "enum": [
                  "todo",
                  "doing",
                  "done"
                ]
              },
              "assigneeId": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "priority": {
                "enum": [
                  "low",
                  "normal",
                  "high",
                  "urgent"
                ]
              },
              "dueAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "id",
              "version",
              "type",
              "title",
              "occurredAt"
            ],
            "properties": {
              "source": {
                "const": "interactions"
              },
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "type": {
                "enum": [
                  "note",
                  "call",
                  "meeting",
                  "email"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "occurredAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
              }
            }
          }
        ]
      }
    },
    "nextAction": {
      "type": "null"
    },
    "dataQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completeness",
        "activitiesComplete",
        "missingFields",
        "issues"
      ],
      "properties": {
        "completeness": {
          "enum": [
            "partial",
            "complete"
          ]
        },
        "activitiesComplete": {
          "type": "boolean"
        },
        "missingFields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "clientId",
              "contactId",
              "currency",
              "probability",
              "closeDate",
              "ownerId",
              "nextAction"
            ]
          }
        },
        "issues": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    }
  }
}
