{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?:sales-orbis[.-]|(?:app\\.)?salesorbis\\.|crm\\.).+"
        }
      ],
      "destination": "/crm",
      "permanent": false
    },
    {
      "source": "/:path((?!(?:crm|sales-pipeline-premium\\.html|sales-posta\\.html|sales-vendite\\.html|lead-intelligence\\.html|sales-linkedin\\.html|sales-growth-campaigns\\.html|sales-growth-projects\\.html|impostazioni\\.html|manifest\\.webmanifest|sales-orbis\\.webmanifest|favicon\\.ico|robots\\.txt)$|(?:sales/|lib/|shell/|api/)).+)",
      "has": [
        {
          "type": "host",
          "value": "(?:sales-orbis[.-]|(?:app\\.)?salesorbis\\.|crm\\.).+"
        }
      ],
      "destination": "/crm",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/control-center-v2.html",
      "permanent": false,
      "missing": [
        {
          "type": "host",
          "value": "(?:sales-orbis[.-]|(?:app\\.)?salesorbis\\.|crm\\.).+"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/accounting-stripe",
      "destination": "/api/accounting?stripe=webhook"
    },
    {
      "source": "/crm",
      "destination": "/radix-sales.html"
    },
    {
      "source": "/api/buffer",
      "destination": "/api/integrations/buffer"
    },
    {
      "source": "/api/heygen",
      "destination": "/api/integrations/heygen"
    },
    {
      "source": "/api/higgsfield",
      "destination": "/api/integrations/higgsfield"
    },
    {
      "source": "/api/openai-image",
      "destination": "/api/integrations/openai-image"
    },
    {
      "source": "/api/send-email",
      "destination": "/api/integrations/send-email"
    },
    {
      "source": "/api/trading",
      "destination": "/api/integrations/trading"
    }
  ],
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/meeting.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/integrations/send-queue",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/integrations/ped-stats",
      "schedule": "0 5 * * *"
    }
  ]
}
