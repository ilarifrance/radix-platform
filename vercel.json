{
  "redirects": [
    {
      "source": "/",
      "destination": "/control-center-v2.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/buffer",
      "destination": "/api/integrations/buffer"
    },
    {
      "source": "/api/heygen",
      "destination": "/api/integrations/heygen"
    },
    {
      "source": "/api/higgsfield",
      "destination": "/api/integrations/higgsfield"
    },
    {
      "source": "/api/openai-image",
      "destination": "/api/integrations/openai-image"
    },
    {
      "source": "/api/send-email",
      "destination": "/api/integrations/send-email"
    }
  ],
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/integrations/send-queue",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/integrations/ped-stats",
      "schedule": "0 5 * * *"
    }
  ]
}
